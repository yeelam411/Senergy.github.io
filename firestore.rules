rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // User owner check: user document must belong to the signed-in auth uid.
    // Recommended: store authUid in each user document.
    function isUserOwner() {
      return isSignedIn()
        && resource.data.authUid is string
        && resource.data.authUid == request.auth.uid;
    }

    // Update compatibility for legacy docs that may be missing authUid.
    function isUserOwnerForUpdate(userId) {
      return isSignedIn()
        && userId == request.auth.uid
        && (
          (resource.data.authUid is string && resource.data.authUid == request.auth.uid)
          || (request.resource.data.authUid is string && request.resource.data.authUid == request.auth.uid)
        );
    }

    // For create, check incoming document ownership.
    function isIncomingUserOwner() {
      return isSignedIn()
        && request.resource.data.authUid is string
        && request.resource.data.authUid == request.auth.uid;
    }

    function isPostOwner() {
      return isSignedIn()
        && resource.data.authorId is string
        && resource.data.authorId == request.auth.uid;
    }

    function isIncomingPostOwner() {
      return isSignedIn()
        && request.resource.data.authorId is string
        && request.resource.data.authorId == request.auth.uid;
    }

    // Users: user document id must equal Firebase Auth uid.
    match /users/{userId} {
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isIncomingUserOwner();

      allow read, delete: if isSignedIn()
        && userId == request.auth.uid
        && isUserOwner();

      allow update: if isUserOwnerForUpdate(userId);
    }

    // Posts: public read; signed-in users can create posts as themselves;
    // only post owner can update/delete.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isIncomingPostOwner();
      allow update, delete: if isPostOwner();
    }

    // Story memos: public board used by story pages.
    match /storyMemos/{memoId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['storyKey', 'text', 'createdAt'])
        && request.resource.data.storyKey is string
        && request.resource.data.storyKey.size() > 0
        && request.resource.data.storyKey.size() <= 64
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow delete: if true;
      allow update: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
